# Backend Environment Variables for LM Pizzeria
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
# Update these with your MySQL credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=lm_pizzeria

# JWT Secret for Authentication
# IMPORTANT: Generate a strong random string for production
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_very_secure_jwt_secret_key_minimum_32_characters

# Frontend URL (for CORS configuration)
# Development: http://localhost:5173
# Production: https://your-frontend-url.com
FRONTEND_URL=http://localhost:5173
